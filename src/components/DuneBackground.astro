---
---
<canvas id="dune-bg" aria-hidden="true"></canvas>

<script is:inline>
  (function () {
    var canvas = document.getElementById('dune-bg');
    if (!canvas) return;
    var gl = canvas.getContext('webgl', { alpha: true, premultipliedAlpha: false });
    if (!gl) return;
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    var VERT =
      'attribute vec2 aPos;varying vec2 vUv;' +
      'void main(){vUv=aPos*0.5+0.5;gl_Position=vec4(aPos,0.0,1.0);}';

    var FRAG = [
      'precision highp float;',
      'varying vec2 vUv;',
      'uniform sampler2D uTex;',
      'uniform vec2 uRes;',
      'uniform vec2 uImg;',
      'uniform vec2 uMouse;',
      'uniform float uStrength;',
      'uniform float uTime;',
      'uniform float uBase;',
      'uniform float uScroll;',
      'uniform float uTheme;',
      'float hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}',
      // one star per grid cell, randomly placed, sized and twinkling
      'float stars(vec2 p,float t){',
      '  vec2 g=floor(p);',
      '  float h=hash(g);',
      '  vec2 o=vec2(hash(g+17.3),hash(g+41.7))*0.6+0.2;',
      '  float size=0.05+0.10*hash(g+7.7)*hash(g+3.1);',
      '  float tw=0.65+0.35*sin(t*(0.6+h*1.8)+h*60.0);',
      '  return step(0.72,h)*smoothstep(size,0.0,length(fract(p)-o))*tw;',
      '}',
      // sparse bright stars with a 4-point sparkle
      'float glint(vec2 p,float t){',
      '  vec2 g=floor(p);',
      '  float h=hash(g);',
      '  vec2 d=abs(fract(p)-(vec2(hash(g+17.3),hash(g+41.7))*0.5+0.25));',
      '  float tw=0.55+0.45*sin(t*(0.6+h*1.8)+h*60.0);',
      '  float rays=smoothstep(0.24,0.0,d.x)*smoothstep(0.02,0.0,d.y)+smoothstep(0.24,0.0,d.y)*smoothstep(0.02,0.0,d.x);',
      '  return step(0.93,h)*(smoothstep(0.07,0.0,length(d))+rays*0.6)*tw;',
      '}',
      'void main(){',
      '  float ca_aspect=uRes.x/uRes.y;',
      '  float im_aspect=uImg.x/uImg.y;',
      '  vec2 scale=ca_aspect>im_aspect?vec2(1.0,im_aspect/ca_aspect):vec2(ca_aspect/im_aspect,1.0);',
      // zoom in 15% so there is spare image to pan through as the page scrolls (parallax)
      '  scale*=0.85;',
      '  vec2 uv=(vUv-0.5)*scale+0.5;',
      '  uv.y+=(0.5-uScroll)*(1.0-scale.y);',
      // pointer field: radial direction + smooth falloff
      '  vec2 dir=vUv-uMouse;',
      '  float dist=length(dir);',
      '  float infl=smoothstep(0.45,0.0,dist)*uStrength;',
      '  vec2 ndir=dist>0.0001?dir/dist:vec2(0.0);',
      // radial ripple displacement, animated
      '  float ripple=sin(dist*38.0-uTime*4.0);',
      '  vec2 disp=ndir*infl*(0.022+0.016*ripple);',
      '  vec2 t=vec2(uv.x,1.0-uv.y);',
      // chromatic aberration: R/G/B split along the displacement direction, scaled by influence
      '  vec2 off=ndir*infl*0.05;',
      '  float r=texture2D(uTex,t+disp+off).r;',
      '  float g=texture2D(uTex,t+disp).g;',
      '  float b=texture2D(uTex,t+disp-off).b;',
      '  vec3 col=vec3(r,g,b);',
      // levels stretch: expand the high-key photo range so the dunes carry real contrast',
      '  col=clamp((col-0.42)/0.5,0.0,1.0);',
      '  float lum=dot(col,vec3(0.299,0.587,0.114));',
      // navy duotone (on-brand): dune shadows -> deep navy, sky -> page-light',
      '  vec3 navy=vec3(0.106,0.227,0.361);',
      '  vec3 duo=mix(navy,vec3(0.95,0.97,0.99),lum);',
      // hover blends toward the raw channels so the chromatic split shows',
      '  col=mix(duo,col,infl*0.6);',
      // keep hover from darkening the text column: lift the hovered area toward page-light',
      '  col=mix(col,vec3(0.95,0.97,0.99),infl*0.15);',
      // animated film grain with slight per-channel chroma sparkle
      '  float gt=floor(uTime*14.0);',
      '  vec3 grain=vec3(hash(vUv*920.0+gt+0.1),hash(vUv*920.0+gt+0.5),hash(vUv*920.0+gt+0.9))-0.5;',
      '  col+=grain*(0.04+infl*0.12);',
      // darker areas (dunes) carry more opacity than the sky, so the desert reads while staying subtle',
      '  float alpha=uBase*(0.4+(1.0-lum)*1.6)+infl*0.32;',
      // night theme (uTheme=1): starfield in three parallax layers, built as additive light L
      '  vec2 sp=vec2(vUv.x*ca_aspect,vUv.y);',
      '  vec3 blue=vec3(0.30,0.52,1.0);',
      '  vec2 p2=sp*40.0-vec2(-5.0,uScroll*4.0)+3.7;',
      '  vec2 p3=sp*14.0-vec2(2.0,uScroll*2.6);',
      '  float tint=hash(floor(p2)+9.0);',
      '  vec3 L=vec3(0.85,0.9,1.0)*stars(sp*85.0-vec2(0.0,uScroll*3.0),uTime)*0.8;',
      '  L+=(tint<0.3?vec3(0.88,0.73,0.36):mix(vec3(1.0),blue,tint))*stars(p2,uTime*0.7);',
      '  L+=mix(vec3(1.0),blue,0.35)*glint(p3,uTime*0.5);',
      // blue haze top-right, violet haze bottom-left, and two arcs: a nod to the bow
      '  L+=blue*smoothstep(1.0,0.0,length(sp-vec2(ca_aspect*0.8,0.7)))*0.24;',
      '  L+=vec3(0.5,0.42,1.0)*smoothstep(0.8,0.0,length(sp-vec2(ca_aspect*0.1,0.1)))*0.12;',
      '  vec2 av=sp-vec2(ca_aspect+0.25,0.4);',
      '  float ar=length(av);',
      '  L+=blue*smoothstep(0.002,0.0,abs(ar-0.75))*step(0.4,fract(atan(av.y,av.x)*60.0))*0.5;',
      '  L+=blue*smoothstep(0.0015,0.0,abs(ar-0.8))*0.2;',
      // pointer: electric-blue glow with the ripple, and nearby stars flare
      '  L*=1.0+infl*1.5;',
      '  L+=blue*infl*(0.22+0.10*ripple);',
      '  float sA=clamp(max(L.r,max(L.g,L.b)),0.0,1.0);',
      '  gl_FragColor=vec4(mix(col,L/max(sA,0.0001),uTheme),mix(alpha,sA,uTheme));',
      '}'
    ].join('\n');

    function compile(type, src) {
      var s = gl.createShader(type);
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    }
    var prog = gl.createProgram();
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    gl.useProgram(prog);

    var buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    var loc = gl.getAttribLocation(prog, 'aPos');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    gl.enable(gl.BLEND);
    gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);

    var U = {
      tex: gl.getUniformLocation(prog, 'uTex'),
      res: gl.getUniformLocation(prog, 'uRes'),
      img: gl.getUniformLocation(prog, 'uImg'),
      mouse: gl.getUniformLocation(prog, 'uMouse'),
      strength: gl.getUniformLocation(prog, 'uStrength'),
      time: gl.getUniformLocation(prog, 'uTime'),
      base: gl.getUniformLocation(prog, 'uBase'),
      scroll: gl.getUniformLocation(prog, 'uScroll'),
      theme: gl.getUniformLocation(prog, 'uTheme')
    };
    gl.uniform1f(U.base, 0.15);

    var tex = gl.createTexture();
    gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, 1, 1, 0, gl.RGBA, gl.UNSIGNED_BYTE, new Uint8Array([200, 215, 235, 255]));

    var imgW = 1, imgH = 1, ready = false;
    var img = new Image();
    img.onload = function () {
      gl.bindTexture(gl.TEXTURE_2D, tex);
      gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, false);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);
      imgW = img.naturalWidth; imgH = img.naturalHeight; ready = true;
      if (reduceMotion) requestAnimationFrame(frame);
    };
    img.src = '/images/dune-bg.webp';

    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    function resize() {
      var w = window.innerWidth, h = window.innerHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      canvas.style.width = w + 'px'; canvas.style.height = h + 'px';
      gl.viewport(0, 0, canvas.width, canvas.height);
      if (reduceMotion && ready) requestAnimationFrame(frame);
    }
    window.addEventListener('resize', resize);
    resize();

    var mouse = { x: 0.5, y: 0.5 }, target = { x: 0.5, y: 0.5 }, strength = 0;
    // parallax pans the full spare image over the first 3 screens of scrolling
    var scroll = 0, scrollTarget = 0, lastActive = 0;
    function readScroll() {
      scrollTarget = Math.min(1, window.scrollY / (window.innerHeight * 3));
    }
    // background mode follows the theme set by the Click tab (0 = dunes, 1 = stars), cross-faded
    function themeMode() { return document.documentElement.dataset.theme === 'archer' ? 1 : 0; }
    var theme = themeMode(), themeTarget = theme;
    new MutationObserver(function () {
      themeTarget = themeMode();
      if (reduceMotion) { theme = themeTarget; requestAnimationFrame(frame); } else wake();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    function wake() {
      lastActive = performance.now();
      if (idleTimer) { clearTimeout(idleTimer); idleTimer = 0; raf = requestAnimationFrame(frame); }
    }
    if (!reduceMotion) {
      var onPointer = function (e) {
        target.x = e.clientX / window.innerWidth;
        target.y = 1 - e.clientY / window.innerHeight;
        strength = Math.min(1, strength + 0.25);
        wake();
      };
      window.addEventListener('pointermove', onPointer, { passive: true });
      window.addEventListener('pointerdown', onPointer, { passive: true });
      window.addEventListener('scroll', function () { readScroll(); wake(); }, { passive: true });
      readScroll();
      scroll = scrollTarget;
    }

    // easing is per 60fps frame; scale by real elapsed time so 120Hz screens match
    var start = performance.now(), last = start, raf = 0, idleTimer = 0;
    var figs = null, figScroll = -1;
    function frame(now) {
      var k = Math.min(now - last, 100) / (1000 / 60);
      last = now;
      var ease = 1 - Math.pow(0.88, k);
      mouse.x += (target.x - mouse.x) * ease;
      mouse.y += (target.y - mouse.y) * ease;
      scroll += (scrollTarget - scroll) * ease;
      strength *= Math.pow(0.95, k);
      theme += (themeTarget - theme) * (1 - Math.pow(0.93, k));
      gl.uniform2f(U.res, canvas.width, canvas.height);
      gl.uniform2f(U.img, imgW, imgH);
      gl.uniform2f(U.mouse, mouse.x, mouse.y);
      gl.uniform1f(U.strength, strength);
      gl.uniform1f(U.scroll, scroll);
      gl.uniform1f(U.theme, theme);
      gl.uniform1f(U.time, (now - start) / 1000);
      gl.uniform1i(U.tex, 0);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      // constellation figures (Constellations.astro) drift with the same smoothed scroll
      figs = figs || document.getElementById('night-figures');
      if (figs && Math.abs(scroll - figScroll) > 0.001) { figScroll = scroll; figs.style.setProperty('--s', scroll.toFixed(3)); }
      raf = idleTimer = 0;
      if (reduceMotion || document.hidden) return;
      // idle: only the grain moves, and it changes 14x/s, so don't redraw faster
      if (strength < 0.005 && Math.abs(themeTarget - theme) < 0.002 && now - lastActive > 600) {
        idleTimer = setTimeout(function () { idleTimer = 0; raf = requestAnimationFrame(frame); }, 1000 / 14);
      } else {
        raf = requestAnimationFrame(frame);
      }
    }
    raf = requestAnimationFrame(frame);
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden && !raf && !idleTimer) { last = performance.now(); raf = requestAnimationFrame(frame); }
    });
  })();
</script>

<style>
  #dune-bg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
</style>
