---
// Arthur's own artwork, brought to life in the margins of the Night Archer theme.
// Each figure is a still image plus a motion map (R = free to move, G = glowing weapon, B = rising smoke);
// the shader below makes hair, cloth and smoke flow and the weapons pulse and sparkle.
// Nothing here downloads or runs until the theme is switched on.
// The archer also draws her bow and looses an arrow of light across the page every few seconds.
import archer from '../assets/night/archer.webp';
import archerMask from '../assets/night/archer-mask.webp';

const figures = [
  { id: 'archer', img: archer, mask: archerMask },
];
---

<div id="night-figures" class="night-figures" aria-hidden="true">
  {figures.map(f => (
    <div class:list={['fig', `fig-${f.id}`]} style={`--ratio:${(f.img.width / f.img.height).toFixed(3)}`}>
      <canvas data-src={f.img.src} data-mask={f.mask.src}></canvas>
    </div>
  ))}
  <i class="shot"></i>
</div>

<script>
  const VERT = 'attribute vec2 p;varying vec2 v;void main(){v=vec2(p.x*.5+.5,.5-p.y*.5);gl_Position=vec4(p,0.,1.);}';
  const FRAG = `
    precision mediump float;
    varying vec2 v;
    uniform sampler2D uTex, uMask;
    uniform vec2 uSize;
    uniform float uTime;
    uniform vec3 uShot;   // archer only: x = arm eased forward (0 = full draw, as painted), y = charge, z = release flash
    float seg(vec2 p, vec2 a, vec2 b, out float s){
      vec2 ab = b - a; s = clamp(dot(p - a, ab) / dot(ab, ab), 0., 1.);
      return length(p - a - ab * s);
    }
    float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
    float noise(vec2 p){
      vec2 i = floor(p), f = fract(p); f = f * f * (3. - 2. * f);
      return mix(mix(hash(i), hash(i + vec2(1., 0.)), f.x), mix(hash(i + vec2(0., 1.)), hash(i + vec2(1., 1.)), f.x), f.y);
    }
    vec2 flow(vec2 p, float t){
      return vec2(noise(p * .02 + vec2(0., t)), noise(p * .02 + vec2(31.7, t))) - .5;
    }
    void main(){
      vec2 px = v * uSize;
      vec3 m = texture2D(uMask, v).rgb;
      // hair, cloth and wings ripple
      vec2 d = (flow(px, uTime * .4) * 16. + vec2(sin(px.y * .03 + px.x * .02 - uTime * 1.5) * 4., 0.)) * m.r;
      // smoke rises: two looping passes hide the jump back
      vec2 rise = (vec2(0., 30.) + flow(px * .6, uTime * .15) * 36.) * m.b;
      // the archer's drawing arm eases forward and pulls back; the string and the bow tips follow, her face stays put
      float pull = uShot.x * 12., s1, s2, sa;
      vec2 hand = vec2(86. + pull, 306.), tip = hand + vec2(149.6, -11.5);
      float arm = 1. - smoothstep(.5, 1., length((px - vec2(55. + pull * .5, 310.)) / vec2(55., 24.)));
      float d1 = seg(px, hand, vec2(150., 152.), s1), d2 = seg(px, hand, vec2(172., 455.), s2);
      float str = max((1. - s1) * (1. - smoothstep(4., 16., d1)), (1. - s2) * (1. - smoothstep(4., 16., d2)));
      float limb = smoothstep(.5, .85, m.g) * pow(min(abs(px.y - 300.) / 150., 1.), 2.);
      d.x -= pull * max(arm, str) * smoothstep(10., 18., length(px - vec2(114., 286.)))
           + uShot.x * 5. * limb + uShot.y * arm * sin(uTime * 38.) * .5;
      float p1 = fract(uTime * .11), p2 = fract(uTime * .11 + .5);
      vec4 c = mix(texture2D(uTex, (px + d + rise * (p2 - .5)) / uSize),
                   texture2D(uTex, (px + d + rise * (p1 - .5)) / uSize), 1. - abs(2. * p1 - 1.));
      // weapons pulse, with a bright band running along them
      float lum = max(c.r, max(c.g, c.b));
      float pulse = .5 + .5 * sin(uTime * 1.5 + px.y * .02);
      float band = smoothstep(.8, 1., .5 + .5 * sin(px.y * .045 + px.x * .02 - uTime * 2.2));
      c.rgb += (c.rgb * m.g * (.25 + .8 * pulse * pulse) + vec3(.55, 1., .85) * lum * m.g * band * .9) * (1. + 1.2 * uShot.y + 1.2 * uShot.z);
      // an arrow of light forms on the string as she draws, then a flash at the bow when it flies
      float da = seg(px, hand, tip, sa);
      vec2 toTip = px - tip, toGrip = px - vec2(214., 300.);
      c += vec4(vec3(.75, 1., .92), .9) * (uShot.y * ((1. - smoothstep(.5, 2.2, da)) * .8 + (1. - smoothstep(1., 9., da)) * sa * .3 + exp(-dot(toTip, toTip) / 40.))
                                          + uShot.z * exp(-dot(toGrip, toGrip) / 900.));
      // sparks drift up through the smoke and off the weapons
      vec2 g = vec2(px.x, px.y + uTime * 13.) / 9.;
      vec2 id = floor(g);
      float h = hash(id);
      float spark = step(.93, h) * smoothstep(.17, 0., length(fract(g) - .5 - (vec2(hash(id + 3.1), hash(id + 7.7)) - .5) * .6))
                  * (.5 + .5 * sin(uTime * (2. + h * 4.) + h * 40.)) * max(m.b, m.g);
      c += vec4(vec3(.75, 1., .9), .8) * spark;
      gl_FragColor = min(c, 1.);
    }`;

  const root = document.documentElement;
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  let draws: ((t: number) => void)[] | null = null;
  let raf = 0, last = 0;

  const image = (src: string) => new Promise<HTMLImageElement>((res, rej) => {
    const i = new Image(); i.onload = () => res(i); i.onerror = rej; i.src = src;
  });

  async function setup(c: HTMLCanvasElement) {
    const src = c.dataset.src!;
    const gl = c.getContext('webgl');
    if (!gl) { c.parentElement!.style.background = `url(${src}) center / contain no-repeat`; return null; }
    const [img, mask] = await Promise.all([image(src), image(c.dataset.mask!)]);
    const prog = gl.createProgram()!;
    for (const [type, code] of [[gl.VERTEX_SHADER, VERT], [gl.FRAGMENT_SHADER, FRAG]] as const) {
      const s = gl.createShader(type)!; gl.shaderSource(s, code); gl.compileShader(s); gl.attachShader(prog, s);
    }
    gl.bindAttribLocation(prog, 0, 'p'); gl.linkProgram(prog); gl.useProgram(prog);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0); gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
    gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, true);
    [img, mask].forEach((tex, n) => {
      gl.activeTexture(gl.TEXTURE0 + n); gl.bindTexture(gl.TEXTURE_2D, gl.createTexture());
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, tex);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    });
    gl.uniform1i(gl.getUniformLocation(prog, 'uTex'), 0);
    gl.uniform1i(gl.getUniformLocation(prog, 'uMask'), 1);
    gl.uniform2f(gl.getUniformLocation(prog, 'uSize'), img.width, img.height);
    const uTime = gl.getUniformLocation(prog, 'uTime'), uShot = gl.getUniformLocation(prog, 'uShot');
    const aims = c.parentElement!.classList.contains('fig-archer');
    let lastU = 0;
    return (t: number) => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      const w = Math.round(c.clientWidth * dpr), h = Math.round(c.clientHeight * dpr);
      if (c.width !== w || c.height !== h) { c.width = w; c.height = h; gl.viewport(0, 0, w, h); }
      gl.uniform1f(uTime, t);
      if (aims && !still.matches) {
        // one shot every 9s: ease the arm forward, hold, draw back, charge, loose
        const u = (t / 9 + .3) % 1, ease = (x: number) => x * x * (3 - 2 * x);
        const relaxed = u < .08 ? ease(u / .08) : u < .25 ? 1 : u < .6 ? 1 - ease((u - .25) / .35) : 0;
        const charge = u < .25 ? 0 : u < .6 ? .3 * ease((u - .25) / .35) : .3 + .7 * (u - .6) / .4;
        gl.uniform3f(uShot, relaxed, charge, Math.exp(-u * 45));
        if (u < lastU) loose(c);
        lastU = u;
      }
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    };
  }

  // the arrow leaves the bow and crosses the page behind the text
  function loose(c: HTMLCanvasElement) {
    const r = c.getBoundingClientRect(), x = r.left + r.width * .93;
    const shot = document.querySelector<HTMLElement>('#night-figures .shot')!;
    shot.style.left = x + 'px'; shot.style.top = r.top + r.height * .326 + 'px';
    shot.animate([{ transform: 'rotate(-4.4deg) translateX(0)', opacity: 1 }, { transform: `rotate(-4.4deg) translateX(${innerWidth - x + 200}px)`, opacity: .7 }],
      { duration: 650, easing: 'cubic-bezier(.15, .6, .4, 1)' });
  }

  function frame(now: number) {
    raf = 0;
    if (root.dataset.theme !== 'archer' || document.hidden) return;
    if (now - last > 30) { last = now; draws!.forEach(d => d(now / 1000)); }   // ~30 frames a second is plenty
    if (!still.matches) raf = requestAnimationFrame(frame);
  }

  async function wake() {
    if (root.dataset.theme !== 'archer') return;
    if (!draws) {
      draws = [];
      const made = await Promise.all([...document.querySelectorAll<HTMLCanvasElement>('#night-figures canvas')].map(setup));
      draws = made.filter(d => d !== null);
    }
    if (!raf) raf = requestAnimationFrame(frame);
  }

  new MutationObserver(wake).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
  document.addEventListener('visibilitychange', wake);
  addEventListener('resize', wake);
  wake();
</script>

<style>
  .night-figures {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition: opacity 800ms ease, visibility 800ms;
  }
  :global(html[data-theme="archer"]) .night-figures {
    opacity: 1;
    visibility: visible;
  }

  /* --s (0 to 1) is the smoothed scroll position, set by DuneBackground; deeper figures drift further */
  .fig {
    position: absolute;
    top: 50%;
    /* fits the margin beside the 860px column, the viewport height, and the artwork's own size */
    width: min(50vw - 460px, 86vh * var(--ratio), 250px);
    aspect-ratio: var(--ratio);
    transform: translateY(calc(-50% - var(--s, 0) * var(--depth) * 1px));
  }
  .fig canvas {
    display: block;
    width: 100%;
    height: 100%;
    animation: drift 9s ease-in-out infinite alternate;
  }
  /* the archer stands on the left so she aims across the page */
  .fig-archer { --depth: 100; left: calc(25vw - 215px); translate: -50%; }
  .fig-archer canvas { animation-duration: 8s; animation-delay: -3s; }

  .shot {
    position: absolute;
    width: 170px;
    height: 2px;
    margin-left: -170px;
    transform-origin: right center;
    opacity: 0;
    background: linear-gradient(90deg, transparent, var(--color-primary));
  }
  .shot::after {
    content: '';
    position: absolute;
    right: -6px;
    top: -5px;
    width: 40px;
    height: 12px;
    background: radial-gradient(closest-side, var(--color-primary), transparent);
  }

  @keyframes drift {
    from { transform: translateY(-6px); }
    to { transform: translateY(6px); }
  }
  /* no margins to stand in: the figures sit faintly behind the text */
  @media (max-width: 1240px) {
    :global(html[data-theme="archer"]) .night-figures { opacity: 0.3; }
    .fig { width: min(42vw, 86vh * var(--ratio), 250px); }
    .fig-archer { left: 23vw; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fig, .fig canvas { animation: none; }
  }
</style>
