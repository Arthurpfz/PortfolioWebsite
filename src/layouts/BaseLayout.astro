---
import Navigation from '../components/Navigation.astro';
import ParticleBackground from '../components/ParticleBackground.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Portfolio of Arthur Pfalzgraf'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <div class="dune-bg" aria-hidden="true"></div>
    <ParticleBackground />
    <Navigation />
    <main id="main-content" role="main">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  .dune-bg {
    position: fixed;
    inset: 0;
    z-index: -2;
    pointer-events: none;
    background: url('/images/dune-bg.png') center / cover no-repeat;
    opacity: 0.15;
    transform: translateZ(0);
    backface-visibility: hidden;
    will-change: transform;
  }
</style>
