---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const articles = await getCollection('articles');
  const publishedArticles = articles.filter(article => !article.data.draft);

  type Article = Awaited<ReturnType<typeof getCollection<'articles'>>>[number];

  // Up to 3 other articles of the same category, most shared tags first, then newest
  function related(entry: Article, all: Article[]) {
    const tags = new Set(entry.data.tags ?? []);
    const shared = (a: Article) => (a.data.tags ?? []).filter(t => tags.has(t)).length;
    const isBook = (a: Article) => a.data.categories?.[0] === 'Book Summary';
    return all
      .filter(a => a.id !== entry.id && isBook(a) === isBook(entry))
      .sort((a, b) => shared(b) - shared(a) || b.data.date.getTime() - a.data.date.getTime())
      .slice(0, 3)
      .map(a => ({ href: `/archive/${a.id.replace(/\.md$/, '')}/`, title: a.data.title }));
  }

  return publishedArticles.map(entry => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry, related: related(entry, publishedArticles) },
  }));
}) satisfies GetStaticPaths;

const { entry, related: relatedArticles } = Astro.props;
const rendered = await render(entry);
const { Content } = rendered;

function formatDate(date: Date) {
  return date.toISOString().split('T')[0];
}

const category = entry.data.categories?.[0] || 'Essay';
const pageTitle = category === 'Book Summary' ? `${entry.data.title}: book summary and notes` : entry.data.title;

// Estimate reading time from raw markdown body
const rawBody = (entry as any).body || '';
const wordCount = rawBody.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<BaseLayout
  title={`${pageTitle} - Arthur Pfalzgraf`}
  description={entry.data.description}
  image={entry.data.image}
  article={{ published: entry.data.date, modified: entry.data.updated }}
>
  <article>
    <header class="article-header">
      <div class="article-header__meta">
        PUBLISHED {formatDate(entry.data.date)}{entry.data.updated && ` · UPDATED ${formatDate(entry.data.updated)}`} · {category.toUpperCase()} · {readingTime} MIN READ
      </div>
      <h1 class="article-header__title">{entry.data.title}</h1>
      {entry.data.tags && entry.data.tags.length > 0 && (
        <div class="tags">
          {entry.data.tags.map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>
    <div class="article-body">
      <Content />
    </div>
    {relatedArticles.length > 0 && (
      <nav class="related" aria-label="Related">
        <div class="related__label">Related</div>
        <ul>
          {relatedArticles.map(r => <li><a href={r.href}>{r.title}</a></li>)}
        </ul>
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .related {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: var(--border);
  }

  .related__label {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: var(--space-sm);
  }

  .related ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .related li {
    margin-bottom: var(--space-sm);
  }

  .related a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-bottom: 1.25em;
    padding-left: var(--space-lg);
  }

  .article-body :global(li) {
    margin-bottom: var(--space-sm);
  }

  .article-body :global(video),
  .article-body :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: var(--space-lg) auto;
    border-radius: 0;
  }

  .article-body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .article-body :global(pre code) {
    background: transparent;
    padding: 0;
  }

  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-lg) 0;
  }

  .article-body :global(th),
  .article-body :global(td) {
    text-align: left;
    vertical-align: top;
    padding: var(--space-sm) var(--space-lg) var(--space-sm) 0;
    border-bottom: var(--border);
  }

  .article-body :global(th):last-child,
  .article-body :global(td):last-child {
    padding-right: 0;
  }

  .article-body :global(th) {
    font-weight: 600;
  }
</style>
