---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from '../components/ArticleList.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles', a => a.data.categories?.[0]?.toLowerCase() === 'book summary');
---

<BaseLayout
  title="Book Summaries - Arthur Pfalzgraf"
  description="13 book summaries on product, behavioral science, and strategy."
>
  <h1>Book Summaries</h1>
  <ArticleList articles={articles} />
</BaseLayout>

<style>
  h1 {
    margin-bottom: var(--space-xl);
  }
</style>
