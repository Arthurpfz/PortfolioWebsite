---
import BaseLayout from '../layouts/BaseLayout.astro';
import { builds, type Build } from '../data/builds';

const statusLabel: Record<Build['status'], string> = {
  shipped: 'SHIPPED',
  'in use': 'IN USE',
  paused: 'PAUSED',
};
---

<BaseLayout
  title="Builds — Arthur Pfalzgraf"
  description="Things I've built on the side, mostly agents and automations for my own use."
>
  <header class="page-header">
    <h1>Builds</h1>
    <p class="intro">Things I've built, mostly for my own use. The feed has them in order; this is the highlight reel. I run a croissant studio!</p>
  </header>

  <section class="builds" aria-label="Builds">
    {builds.map(b => (
      <article class="build">
        <header class="build-header">
          <h2 class="build-name">{b.name}</h2>
          <div class="build-status">{statusLabel[b.status]}</div>
        </header>
        <p class="build-tagline">{b.tagline}</p>
        <div class="build-meta">{b.stack}</div>
        {b.links && (
          <div class="build-links">
            {b.links.map(link => (
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}{link.external && ' ↗\uFE0E'}
              </a>
            ))}
          </div>
        )}
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .page-header {
    padding: var(--space-lg) 0 var(--space-md);
  }

  .intro {
    max-width: 680px;
    margin-top: var(--space-sm);
    line-height: 1.6;
  }

  .builds {
    border-top: var(--border);
  }

  .build {
    padding: var(--space-lg) 0;
    border-bottom: var(--border);
  }

  .build-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  .build-name {
    font-size: 17px;
    margin: 0;
  }

  .build-status {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: var(--text-tag);
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .build-tagline {
    max-width: 680px;
    line-height: 1.6;
    margin: 0 0 var(--space-sm) 0;
  }

  .build-meta {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: var(--space-sm);
  }

  .build-links {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    display: flex;
    gap: var(--space-md);
  }

  .build-links a {
    text-decoration: underline;
    opacity: 0.75;
  }

  .build-links a:hover {
    opacity: 1;
  }
</style>
